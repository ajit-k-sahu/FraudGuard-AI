# FraudGuard -AI Environment Configuration Template
# Duplicate this file to .env and configure values before starting the application.

# Application Environment (development, testing, production)
FLASK_ENV=development
FLASK_APP=run.py

# Security Secret Key
# In development, a fallback dev key is provided.
# In production, a strong externally supplied key is MANDATORY.
# Generate a secure 32-byte key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key-in-production-use-a-strong-random-hex

# Database Connection
DATABASE_URL=sqlite:///instance/fraudguard.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://username:password@db-host:5432/fraudguard_db

# Rate Limiting & Storage Backend
# In local development: memory:// (process-local)
# In production multi-worker deployment: redis://[:password@]host:6379/0 (shared across workers)
RATELIMIT_STORAGE_URI=memory://
# For production Redis:
# REDIS_URL=redis://username:password@redis-host:6379/0

# Reverse Proxy Trust Configuration
# Set USE_PROXY_FIX=True and NUM_PROXIES=1 when running behind Cloudflare, Render, AWS ALB, or Nginx
USE_PROXY_FIX=False
NUM_PROXIES=1

# Machine Learning & Fraud Risk Stratification Thresholds
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_HIGH=0.70
DEMO_MODE=True

# Matplotlib cache directory
MPLCONFIGDIR=./instance/mpl_cache

# Initial Administrator Seed Credentials (Required for production admin provisioning)
ADMIN_EMAIL=admin@fraudguard.ai
ADMIN_PASSWORD=replace-with-a-strong-production-admin-password
